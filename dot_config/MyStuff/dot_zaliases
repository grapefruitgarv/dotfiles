# When running OpenClaw and wanting to check stats from Headroom
hroom() {
    docker exec openclaw_gateway curl -s http://headroom_google_proxy:8787/stats | jq '{
  requests_processed: .display_session.requests,
  total_input_tokens: .display_session.total_input_tokens,
  cache_read_tokens: .display_session.cache_read_tokens,
  tokens_saved_direct: .tokens.saved,
  compression_savings_usd: .display_session.compression_savings_usd,
  cache_savings_usd: .display_session.cache_savings_usd,
  total_saved_usd: ((.display_session.compression_savings_usd // 0) + (.display_session.cache_savings_usd // 0)),
  cost_incurred_usd: .display_session.total_input_cost_usd
}'
}

# And to get a text output, not json
hroom1() {
    docker exec openclaw_gateway curl -s http://headroom_google_proxy:8787/stats | jq -r '
  "[" + (.display_session.requests | tostring) + " reqs] " +
  "Cost Incurred: $" + ((.display_session.total_input_cost_usd // 0) | tostring) + " | " +
  "Total Saved: $" + (((.display_session.compression_savings_usd // 0) + (.display_session.cache_savings_usd // 0)) | tostring) + " " +
  "(Direct: " + (.tokens.saved | tostring) + " toks, Cache Reads: " + (.display_session.cache_read_tokens | tostring) + " toks)"
'
}

# Stats for Ollama on OpenClaw
hroomo() {
    docker exec openclaw_gateway curl -s http://headroom_ollama_proxy:8788/stats | jq '{
  requests_processed: .display_session.requests,
  tokens_saved_direct: .tokens.saved,
  cache_read_tokens: .display_session.cache_read_tokens,
  total_input_tokens: .display_session.total_input_tokens,
  savings_percent: .display_session.savings_percent
}'
}

hroomo1 () {
    docker exec openclaw_gateway curl -s http://headroom_ollama_proxy:8788/stats | jq -r '
  "[" + (.display_session.requests | tostring) + " reqs] " +
  "Input Tokens: " + (.display_session.total_input_tokens | tostring) + " | " +
  "Direct Saved: " + ((.tokens.saved // 0) | tostring) + " tokens | " +
